# Copy to .env.local. Never commit real credentials or session keys.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Optional comma-separated callbacks registered in Spotify, e.g. a permanent mobile HTTPS address.
SPOTIFY_ADDITIONAL_REDIRECT_URIS=
# Generate a long random value; keep it stable to preserve login sessions.
SPOTIFY_SESSION_SECRET=

# Required on Vercel production: shared request pacing (Upstash integration supplies these).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Use the same key for deployments using the same Spotify developer quota.
SPOTIFY_GATE_KEY=record-cabinet:spotify:developer
